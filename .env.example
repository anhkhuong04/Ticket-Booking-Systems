# Copy this file to .env and replace both password placeholders before starting.
POSTGRES_DB=lak
POSTGRES_USER=lak
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Use non-default host ports so a locally installed PostgreSQL/Redis service can coexist.
POSTGRES_PORT=5433
POSTGRES_URL=jdbc:postgresql://localhost:5433/lak

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=replace-with-a-strong-local-password

BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Email delivery is disabled locally until a provider endpoint and token are configured.
MAIL_ENABLED=false
MAIL_PROVIDER=http
MAIL_ENDPOINT=https://email-provider.example/api/send
MAIL_API_TOKEN=replace-with-a-provider-token
MAIL_FROM_ADDRESS=no-reply@example.com

# Cloudinary direct-upload signing is disabled until these credentials are configured.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lak-movies
CLOUDINARY_MAX_UPLOAD_MEGABYTES=3

VITE_API_URL=http://localhost:8080

# Generate a unique value with at least 32 random bytes. Never commit the real production secret.
JWT_HMAC_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TOKEN_TTL=30m
PASSWORD_RESET_URL=http://localhost:5173/reset-password
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW=1m
HOLD_RATE_LIMIT=20
HOLD_RATE_LIMIT_WINDOW=1m
CHECKOUT_RATE_LIMIT=10
CHECKOUT_RATE_LIMIT_WINDOW=1m
WEBHOOK_RATE_LIMIT=120
WEBHOOK_RATE_LIMIT_WINDOW=1m
SCAN_RATE_LIMIT=30
SCAN_RATE_LIMIT_WINDOW=1m

# Seat holds are decided by PostgreSQL; Redis only mirrors their TTL for realtime support.
SEAT_HOLD_TTL=5m
SEAT_HOLD_IDEMPOTENCY_TTL=24h
SEAT_HOLD_EXPIRY_POLL_INTERVAL=20s
SEAT_HOLD_EXPIRY_BATCH_SIZE=100

# Checkout does not extend the hold. Payment may be accepted only during this later grace period.
BOOKING_CHECKOUT_IDEMPOTENCY_TTL=24h
PAYMENT_GRACE_PERIOD=2m

# Sandbox payment adapter. Use a unique 32+ character secret; never commit a production provider secret.
PAYMENT_RECONCILIATION_POLL_INTERVAL=30s
PAYMENT_RECONCILIATION_BATCH_SIZE=100
SANDBOX_PAYMENT_CHECKOUT_URL=http://localhost:5173/payments/sandbox
SANDBOX_PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Local only: import verified CGV movie metadata plus fictional LAK cinema operations.
# The generator never runs under the prod or test profiles.
DEMO_SEED_ENABLED=true
